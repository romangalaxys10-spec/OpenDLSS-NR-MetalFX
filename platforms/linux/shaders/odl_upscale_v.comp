// odl_upscale_v.comp — Lanczos3 resampling, vertical pass (f32 -> f32).
// Port of Media.metal's odl_upscale_v.
//
// Push constants: [0] dstH
// Bindings: 0 src RGBA32Float (srcW x dstH source), 1 dst RGBA32Float
//
// Dispatch: 16x16 workgroups over srcW x dstH.
// Copyright (c) 2026 OpenDLSS-NR MetalFX contributors. MIT License.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "Common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, set = 0, binding = 0) restrict readonly uniform image2D src;
layout(rgba32f, set = 0, binding = 1) restrict writeonly uniform image2D dst;

void main() {
    const uint dstH = pcu(0);
    const ivec2 srcSz = imageSize(src);
    const ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= srcSz.x || gid.y >= int(dstH)) return;

    const float scale = float(srcSz.y) / float(dstH);
    const float support = 3.0;
    float cy = (float(gid.y) + 0.5) * scale - 0.5;
    int lo = int(floor(cy - support + 0.5));
    int hi = int(floor(cy + support + 0.5));
    vec4 acc = vec4(0.0);
    float wsum = 0.0;
    for (int s = lo; s <= hi; ++s) {
        float w = odl_lanczos3((float(s) - cy) * min(scale, 1.0));
        if (w == 0.0) continue;
        uint sy = uint(clamp(s, 0, srcSz.y - 1));
        acc += imageLoad(src, ivec2(gid.x, int(sy))) * w;
        wsum += w;
    }
    imageStore(dst, gid, acc / wsum);
}
