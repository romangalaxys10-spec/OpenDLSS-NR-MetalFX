// odl_channel_gemm.comp — any [out][in] row-major weight GEMM applied per
// token, f16 weights / f32 accumulate. pubMode 0 = publish E4M3,
// 1 = publish raw f16 (matches the CPU reference's per-edge publication).
// Port of Graph.metal's odl_channel_gemm (the bias is selected by a flag —
// GLSL cannot null-check an SSBO).
//
// Push constants: [0] tokens [1] outCh [2] inCh [3] pubMode [4] hasBias
// Bindings: 0 x [tokens][in], 1 w [out][in], 2 b [out] (dummy when absent),
//           7 out [tokens][out]
//
// Dispatch: 64-thread workgroups over tokens*outCh.
// Copyright (c) 2026 OpenDLSS-NR MetalFX contributors. MIT License.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "Common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) restrict readonly buffer X { uint x[]; };
layout(std430, set = 0, binding = 1) restrict readonly buffer W { uint w[]; };
layout(std430, set = 0, binding = 2) restrict readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 7) restrict writeonly buffer Out { uint outBuf[]; };

void main() {
    const uint tokens  = pcu(0);
    const uint outCh   = pcu(1);
    const uint inCh    = pcu(2);
    const uint pubMode = pcu(3);
    const bool hasBias = pcu(4) != 0u;
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= tokens * outCh) return;
    const uint t = gid / outCh;
    const uint o = gid % outCh;

    float s = (hasBias ? ODL_LD(b, o) : 0.0);
    for (uint i = 0; i < inCh; ++i)
        s += ODL_LD(w, o * inCh + i) * ODL_LD(x, t * inCh + i);
    outBuf[gid] = pubMode == 0u ? odl_f32_to_f16(odl_pub_e4m3(s))
                             : odl_f32_to_f16(s);
}
