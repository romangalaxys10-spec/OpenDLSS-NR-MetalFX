// odl_global_attention.comp — global (ViT) attention over all level tokens.
// Port of Graph.metal's odl_global_attention with the CPU reference's
// numerics: three separate half multiplies on q (normalize, *sqrt(32),
// *learned scale), one on k; q/k published E4M3; unnormalized weights through
// the global bit-trick exponential with the exp(0) padding correction:
// padding keys are zero vectors so their raw weight equals exp(0); it is
// added to the denominator and subtracted back out afterwards, exactly like
// the reference (their v contribution is zero).
//
// Push constants: [0] tokensReal [1] C [2] heads
// Bindings: 0 qkv [tokens][3C] (tokens padded to a multiple of 64,
//           padding rows zero), 1 qscale [heads], 5 headO [tokensReal][C]
//
// Dispatch: ceil(tokensReal/32) workgroups of 32 threads; one thread per
// real query token.
// Copyright (c) 2026 OpenDLSS-NR MetalFX contributors. MIT License.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "Common.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) restrict readonly buffer Qkv {
    uint qkv[];      // [tokens][3C] half-as-uint32 (qkv GEMM published f16)
};
layout(std430, set = 0, binding = 1) restrict readonly buffer Qscale {
    uint qscale[];   // [heads] half-as-uint32
};
layout(std430, set = 0, binding = 5) restrict writeonly buffer HeadO {
    uint headO[];    // [tokensReal][C] half-as-uint32, E4M3 published
};

void main() {
    const uint tokensReal = pcu(0);
    const uint C     = pcu(1);
    const uint heads = pcu(2);
    const uint HD    = 32u;
    const uint tokens = (tokensReal + 63u) / 64u * 64u;
    const uint a = gl_GlobalInvocationID.x;
    if (a >= tokensReal) return;

    const float s32  = sqrt(32.0);
    const float exp0 = odl_global_exp(0.0);

    for (uint h = 0; h < heads; ++h) {
        const uint qaBase = a * 3u * C + h * HD;
        float qn = 0.0;
        for (uint d = 0; d < HD; ++d) {
            float q = ODL_LD(qkv, qaBase + d);
            qn += q * q;
        }
        qn = sqrt(qn);
        const float invQ = qn > 0.0 ? 1.0 / qn : 0.0;
        const float qs = ODL_LD(qscale, h);

        float denom = 0.0;
        float o[32];
        for (uint d = 0; d < HD; ++d) o[d] = 0.0;

        for (uint b = 0; b < tokens; ++b) {
            const uint kbBase = b * 3u * C + C + h * HD;
            const uint vbBase = b * 3u * C + 2u * C + h * HD;
            float kn = 0.0;
            for (uint d = 0; d < HD; ++d) {
                float k = ODL_LD(qkv, kbBase + d);
                kn += k * k;
            }
            kn = sqrt(kn);
            const float invK = kn > 0.0 ? 1.0 / kn : 0.0;

            float s = 0.0;
            for (uint d = 0; d < HD; ++d) {
                // three separate half multiplies: q*norm, *sqrt(32), *learned
                float q = odl_f16_to_f32(odl_f32_to_f16(ODL_LD(qkv, qaBase + d) * invQ));
                q = odl_f16_to_f32(odl_f32_to_f16(q * s32));
                q = odl_f16_to_f32(odl_f32_to_f16(q * qs));
                float k = odl_f16_to_f32(odl_f32_to_f16(ODL_LD(qkv, kbBase + d) * invK));
                s += odl_pub_e4m3(q) * odl_pub_e4m3(k);
            }
            float w = odl_pub_e4m3(odl_global_exp(s));
            denom += w;
            for (uint d = 0; d < HD; ++d)
                o[d] += w * odl_pub_e4m3(ODL_LD(qkv, vbBase + d));
        }
        denom -= exp0 * float(tokens - tokensReal);   // reference padding correction
        const float invD = denom > 0.0 ? 1.0 / denom : 0.0;
        for (uint d = 0; d < HD; ++d)
            ODL_ST(headO, a * C + h * HD + d, odl_pub_e4m3(o[d] * invD));
    }
}
