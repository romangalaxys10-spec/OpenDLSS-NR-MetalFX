// odl_input_embed.comp — input embedding: tokens = input_proj (C0 x 16)
// applied per field token, published E4M3.
// Port of Preprocess.metal's odl_input_embed.
//
// Dispatch: 64-thread workgroups over field tokens.
// Copyright (c) 2026 OpenDLSS-NR MetalFX contributors. MIT License.
#version 450
#extension GL_GOOGLE_include_directive : enable
#include "Common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) restrict readonly buffer Feat {
    uint features[];   // [field][16] half-as-uint32
};
layout(std430, set = 0, binding = 1) restrict readonly buffer Proj {
    uint proj[];       // [C0][16] half-as-uint32
};
layout(std430, set = 0, binding = 2) restrict writeonly buffer State {
    uint state[];      // [field][C0] half-as-uint32, E4M3 published
};

void main() {
    uvec2 fieldSize = pcuv2(0);
    const uint channels = pcu(2);
    const uint tokens = fieldSize.x * fieldSize.y;
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= tokens) return;

    for (uint o = 0; o < channels; ++o) {
        float s = 0.0;
        for (uint i = 0; i < 16u; ++i)
            s += ODL_LD(proj, o * 16u + i) * ODL_LD(features, gid * 16u + i);
        ODL_ST(state, gid * channels + o, odl_pub_e4m3(s));
    }
}
